# Public URL of the private GitHub bridge used by the Builder.
# Set this as the GitHub Actions repository variable VITE_GITHUB_BRIDGE_URL.
VITE_GITHUB_BRIDGE_URL=

# Canonical public URL used when generating QR codes. If omitted, the Builder
# falls back to the public Infinity Card Pages URL instead of localhost.
VITE_PUBLIC_SITE_URL=https://infinity-card.github.io/infinity-card/
