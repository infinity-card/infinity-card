{
  "name": "infinity-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "validate:clients": "node scripts/validate-client-folders.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test --test-isolation=none tests/sites-worker.test.mjs",
    "test:bridge": "node scripts/test-github-bridge.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite --configLoader native",
    "prebuild": "npm run check:runtime && npm run validate:clients",
    "prebuild:pages": "npm run check:runtime && npm run validate:clients",
    "build": "tsc && vite build --configLoader native && node scripts/prepare-sites-build.mjs",
    "build:pages": "tsc && vite build --configLoader native --base ./ --outDir dist/pages && node scripts/prepare-pages-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@types/qrcode": "^1.5.6",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
